[Unit]
Description=uploadthing — Abgabensystem (Prüfungsserver)
Documentation=file:/home/georg/repos/georgernstgraf/uploadthing/docs/ai/OPERATIONS.md

[Service]
Type=simple
WorkingDirectory=/home/georg/repos/georgernstgraf/uploadthing
EnvironmentFile=/home/georg/.config/uploadthing/uploadthing.env

# Erst starten, wenn das gelbe Interface (Prüfungsnetz) seine Adresse hat.
ExecStartPre=/bin/sh -c 'ip -4 -o addr show enx7cc2c615cba8 | grep -q "inet 192.168.21.2/"'

# User-Unit: 443 ist unprivilegiert bindbar über
# net.ipv4.ip_unprivileged_port_start=443 (/etc/sysctl.d/99-uploadthing-ports.conf).
# AmbientCapabilities gibt es im User-Manager nicht.
ExecStart=/home/georg/.deno/bin/deno run --allow-all /home/georg/repos/georgernstgraf/uploadthing/main.ts

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
