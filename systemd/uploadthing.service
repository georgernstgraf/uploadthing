[Unit]
Description=uploadthing — Abgabensystem (Prüfungsserver)
Documentation=file:/home/georg/uploadthing-app/docs/ai/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=georg
Group=georg
WorkingDirectory=/home/georg/uploadthing-app
EnvironmentFile=/home/georg/uploadthing-app/.env

# Port 443 ohne root: nur diese Capability, sonst nichts.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Der Dell ist ein Laptop: Zuklappen darf die Prüfung nicht töten.
ExecStart=/home/georg/.deno/bin/deno run --allow-all /home/georg/uploadthing-app/main.ts

# Erst starten, wenn das gelbe Interface (Prüfungsnetz) seine Adresse hat.
ExecStartPre=/bin/sh -c 'ip -4 -o addr show enx7cc2c615cba8 | grep -q "inet 192.168.21.2/"'

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
