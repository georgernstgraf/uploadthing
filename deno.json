{
    "tasks": {
        "dev": "deno run -A --env-file --watch=templates/,.env main.ts",
        "start": "deno run -A --env-file main.ts",
        "stop": "scripts/stop.sh",
        "test": "scripts/test-with-server.sh",
        "e2e": "scripts/e2e.sh",
        "check": "deno check *ts lib/*ts routes/*ts ./middleware/*ts repo/*ts service/*ts drizzle/*ts",
        "lint": "deno lint *.ts lib/ middleware/ repo/ routes/ service/ test/ drizzle/",
        "fullcheck": "deno task check && deno task lint && deno task test",
        "db:generate": "deno run -A --env-file --node-modules-dir=auto npm:drizzle-kit generate",
        "db:migrate": "deno run -A --env-file lib/migrate.ts"
    },
    "imports": {
        "@db/sqlite": "jsr:@db/sqlite@0.12.0",
        "@std/assert": "jsr:@std/assert@1",
        "@std/media-types": "jsr:@std/media-types@1",
        "@std/path": "jsr:@std/path@1",
        "drizzle-kit": "npm:drizzle-kit@0.31.11",
        "drizzle-orm": "npm:drizzle-orm@0.45.3",
        "file-type": "npm:file-type@^16.5.4",
        "handlebars": "npm:handlebars@^4.7.8",
        "hono": "npm:hono@^4.10.6",
        "htmx.org": "npm:htmx.org@^2.0.8",
        "ldapts": "npm:ldapts@^8.1.3",
        "playwright-core": "npm:playwright-core@1.61.1",
        "zod": "npm:zod@^3.24.1",
        "zod-form-data": "npm:zod-form-data@^2.0.2",
        "he": "npm:he@^1.2.0"
    },
    "fmt": {
        "indentWidth": 4
    },
    "lint": {
        "include": [
            "*.ts",
            "lib/",
            "middleware/",
            "repo/",
            "routes/",
            "service/",
            "test/",
            "drizzle/"
        ]
    }
}
