{{#if error}}
    <div class="list-group-item text-danger">{{error}}</div>
{{/if}}
{{#each users}}
    <button type="button"
            class="list-group-item list-group-item-action text-start"
            hx-post="/register"
            hx-vals='{"email": "{{email}}"}'
            hx-target="#app-main"
            hx-swap="outerHTML"
            hx-disabled-elt="this"><span class="fw-semibold">{{label}}{{#if klasse}} · {{klasse}}{{/if}}</span></button>
{{/each}}
{{#if empty}}
    <div class="list-group-item text-body-secondary">Keine Person gefunden. Bitte anders schreiben, zum Beispiel nur den Nachnamen.</div>
{{/if}}
{{#if has_more}}
    <div class="list-group-item text-body-secondary small">Es gibt weitere Treffer – bitte mehr Zeichen eingeben.</div>
{{/if}}
