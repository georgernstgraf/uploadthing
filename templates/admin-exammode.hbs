{{#*inline "exam-extra-form"}}
<form id="exam-extra-form"
      class="w-100"
      hx-post="/api/exam/extra"
      hx-target="#exam-admin-panel"
      hx-swap="outerHTML"
      hx-disabled-elt="find button[type='submit']">
    <label class="form-label fw-bold" for="exam-extra-minutes">Zusatzzeit (Minuten)</label>
    <div class="row g-2 justify-content-center align-items-end">
        <div class="col-md-6">
            <input id="exam-extra-minutes"
                   name="minutes"
                   type="number"
                   class="form-control text-center"
                   min="1"
                   max="600"
                   step="1"
                   value="5"
                   required>
        </div>
        <div class="col-md-4 d-grid">
            <button type="submit"
                    class="btn btn-secondary">Zusatzzeit hinzufügen</button>
        </div>
    </div>
    <div class="form-text text-center mt-2">Ganzzahl zwischen 1 und 600 Minuten.</div>
</form>
{{/inline}}
<div id="exam-admin-panel" class="vstack gap-2">
    {{#if exam_hazards.length}}
        <div id="exam-warning"
             class="alert alert-danger text-center mb-0"
             role="alert">
            <div class="fs-5 fw-bold mb-1">Examen läuft — nicht vollständig gesperrt</div>
            {{#each exam_hazards}}
                <div id="exam-warning-{{this.key}}"
                     class="mt-1"
                     data-hazard="{{this.key}}">
                    <span class="fw-semibold">{{this.title}}</span>
                    <div class="small">{{this.detail}}</div>
                </div>
            {{/each}}
        </div>
    {{/if}}

    <div class="card shadow-sm">
        <div class="card-header bg-transparent border-0 text-center pt-3 pb-0">
            <h4 class="card-title fw-bold fs-5 mb-1">Examen-Steuerung</h4>
            <p class="card-text small mb-0">Prüfungsdauer, Zusatzzeit und Pausensteuerung für den laufenden Durchgang.</p>
        </div>
        <div class="card-body d-flex flex-column align-items-center text-center gap-3 pt-3">
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <span id="exam-status-badge"
                      class="badge rounded-pill px-3 py-2 fs-6 {{#if (eq exam_status "running")}}text-bg-success{{else if (eq exam_status "paused")}}text-bg-warning{{else}}text-bg-secondary{{/if}}">
                    {{#if (eq exam_status "running")}}Examen läuft{{else if (eq exam_status "paused")}}Examen pausiert{{else if (eq exam_status "stopped")}}Examen beendet{{else}}Kein Examen{{/if}}
                </span>
                {{#if exam_open}}
                    <span id="exam-remaining-badge"
                          class="badge rounded-pill px-3 py-2 fs-6 text-bg-dark">Restzeit: {{exam_remaining_label}}</span>
                {{/if}}
            </div>
            {{#if (eq exam_status "stopped")}}
                <p class="small mb-0">Das Examen wurde beendet, das Internet ist wieder freigeschaltet. Ein neuer Start ist jederzeit möglich.</p>
            {{/if}}
            {{#if success_message}}
                <div class="alert alert-success mb-0 w-100" role="alert">{{success_message}}</div>
            {{/if}}

            {{#if (eq exam_status "running")}}
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <button id="exam-pause-button"
                            type="button"
                            class="btn btn-warning fw-semibold"
                            hx-post="/api/exam/pause"
                            hx-target="#exam-admin-panel"
                            hx-swap="outerHTML"
                            hx-disabled-elt="this">Pause</button>
                    <button id="exam-stop-button"
                            type="button"
                            class="btn btn-danger fw-semibold"
                            hx-post="/api/exam/stop"
                            hx-target="#exam-admin-panel"
                            hx-swap="outerHTML"
                            hx-disabled-elt="this">Stopp</button>
                </div>
                {{> exam-extra-form }}
            {{else if (eq exam_status "paused")}}
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <button id="exam-resume-button"
                            type="button"
                            class="btn btn-success fw-semibold"
                            hx-post="/api/exam/resume"
                            hx-target="#exam-admin-panel"
                            hx-swap="outerHTML"
                            hx-disabled-elt="this">Fortsetzen</button>
                    <button id="exam-stop-button"
                            type="button"
                            class="btn btn-danger fw-semibold"
                            hx-post="/api/exam/stop"
                            hx-target="#exam-admin-panel"
                            hx-swap="outerHTML"
                            hx-disabled-elt="this">Stopp</button>
                </div>
                {{> exam-extra-form }}
            {{else}}
                <form id="exam-start-form"
                      class="w-100"
                      hx-post="/api/exam/start"
                      hx-target="#exam-admin-panel"
                      hx-swap="outerHTML"
                      hx-disabled-elt="find button[type='submit']">
                    <label class="form-label fw-bold" for="exam-duration-minutes">Prüfungsdauer (Minuten)</label>
                    <div class="row g-2 justify-content-center align-items-end">
                        <div class="col-md-6">
                            <input id="exam-duration-minutes"
                                   name="minutes"
                                   type="number"
                                   class="form-control text-center"
                                   min="1"
                                   max="600"
                                   step="1"
                                   value="90"
                                   required>
                        </div>
                        <div class="col-md-4 d-grid">
                            <button type="submit"
                                    class="btn btn-primary fw-semibold">Examen starten</button>
                        </div>
                    </div>
                    <div class="form-text text-center mt-2">Ganzzahl zwischen 1 und 600 Minuten. Nach dem Start sind Uploads und Unterlagen freigegeben.</div>
                </form>
            {{/if}}
            <div class="htmx-indicator small">Examen wird aktualisiert ...</div>
        </div>
    </div>

    <form id="exam-firewall-form"
          hx-post="/api/exammode"
          hx-trigger="change"
          hx-target="#exam-admin-panel"
          hx-swap="outerHTML"
          class="w-100">
        <div class="card shadow-sm {{#if (eq firewall_state "frei")}}border-success-subtle bg-success-subtle{{else if (eq firewall_state "gesperrt")}}border-danger-subtle bg-danger-subtle{{else if (eq firewall_state "unbekannt")}}border-warning-subtle bg-warning-subtle{{else}}border-secondary-subtle{{/if}}">
            <div class="card-header bg-transparent border-0 text-center pt-3 pb-0">
                <h4 class="card-title fw-bold fs-5 mb-1">Dokumentationsserver-Firewall-Regel</h4>
                <p class="card-text small mb-0">Schaltet den Internetzugang für die Prüfungsumgebung während des Betriebs um.</p>
            </div>
            <div class="card-body d-flex flex-column align-items-center text-center gap-3 pt-3">
                <div class="form-check form-switch m-0 d-flex justify-content-center">
                    <input id="internet_active"
                           name="internet_active"
                           type="checkbox"
                           role="switch"
                           class="form-check-input exam-switch mt-0 {{#if (eq firewall_state "frei")}}bg-success border-success{{else if (eq firewall_state "gesperrt")}}bg-danger border-danger{{/if}}"
                           {{#if (eq firewall_state "frei")}}checked{{/if}}
                           {{#if (or (eq firewall_state "unbekannt") (eq firewall_state "nicht-konfiguriert"))}}disabled{{/if}}>
                </div>
                <div id="exam-firewall-badge"
                     class="badge rounded-pill px-3 py-2 fs-6 {{#if (eq firewall_state "frei")}}text-bg-success{{else if (eq firewall_state "gesperrt")}}text-bg-danger{{else if (eq firewall_state "unbekannt")}}text-bg-warning{{else}}text-bg-secondary{{/if}}">
                    {{#if (eq firewall_state "frei")}}Internet frei{{else if (eq firewall_state "gesperrt")}}Internet gesperrt{{else if (eq firewall_state "unbekannt")}}Zustand unbekannt{{else}}Nicht konfiguriert{{/if}}
                </div>
                <p class="small mb-0">
                    {{#if (eq firewall_state "frei")}}Die Firewall-Regel ist deaktiviert. Voller Internetzugang ist freigegeben.{{else if (eq firewall_state "gesperrt")}}Die Firewall-Regel ist aktiviert. Internetzugang ist gesperrt.{{else if (eq firewall_state "unbekannt")}}Der Zustand der Firewall-Regel konnte nicht gelesen werden. Der Schalter bleibt gesperrt, bis der Fehler behoben ist.{{else}}Für diese Umgebung sind keine OPNsense-API-Zugangsdaten gesetzt. Die Firewall lässt sich hier nicht schalten.{{/if}}
                </p>
                {{#if firewall_error}}{{#unless (eq firewall_state "nicht-konfiguriert")}}
                    <p id="exam-firewall-error" class="small text-danger mb-0">{{firewall_error}}</p>
                {{/unless}}{{/if}}
                <div class="htmx-indicator small">Firewall-Regel wird aktualisiert ...</div>
            </div>
        </div>
    </form>

    {{#if exam_running}}
        <form id="exam-registration-form"
              hx-post="/api/exam/registration"
              hx-trigger="change"
              hx-target="#exam-admin-panel"
              hx-swap="outerHTML"
              class="w-100">
            <div id="exam-registration-card"
                 class="card shadow-sm {{#if registration_open}}border-warning-subtle bg-warning-subtle{{else}}border-secondary-subtle{{/if}}">
                <div class="card-header bg-transparent border-0 text-center pt-3 pb-0">
                    <h4 class="card-title fw-bold fs-5 mb-1">Anmeldung während des Examens</h4>
                    <p class="card-text small mb-0">Schaltet die Neuanmeldung für Schüler um. Ohne Freigabe kann sich während der Prüfung niemand neu anmelden.</p>
                </div>
                <div class="card-body d-flex flex-column align-items-center text-center gap-3 pt-3">
                    <div class="form-check form-switch m-0 d-flex justify-content-center">
                        <input id="registration_open"
                               name="registration_open"
                               type="checkbox"
                               role="switch"
                               class="form-check-input exam-switch mt-0 {{#if registration_open}}bg-warning border-warning{{/if}}"
                               {{#if registration_open}}checked{{/if}}>
                    </div>
                    <div id="exam-registration-badge"
                         class="badge rounded-pill px-3 py-2 fs-6 {{#if registration_open}}text-bg-warning{{else}}text-bg-secondary{{/if}}">
                        {{#if registration_open}}Anmeldung freigegeben{{else}}Anmeldung gesperrt{{/if}}
                    </div>
                    <p class="small mb-0">
                        {{#if registration_open}}Schüler dürfen sich neu anmelden. Ein Namenswechsel während der Prüfung ist damit möglich, bis du den Schalter wieder ausschaltest.{{else}}Während der Prüfung ist die Neuanmeldung gesperrt, damit niemand den Namen wechselt. Freigeben nur, wenn jemand seine Sitzung verloren hat.{{/if}}
                    </p>
                    <div class="htmx-indicator small">Anmelde-Freigabe wird aktualisiert ...</div>
                </div>
            </div>
        </form>
    {{/if}}

    <div id="exam-firewall-modal-data"
         hidden
         data-show="{{#if firewall_modal}}true{{else}}false{{/if}}"
         data-message="{{firewall_error}}"></div>
</div>
