<!DOCTYPE html>
<html lang="de"
      data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title>{{page_title}}</title>
    <script>
        (function () {
            const themeAssetVersion = '{{theme_asset_version}}';
            const savedMode = localStorage.getItem('uploadthing-mode');
            const mode = savedMode === 'dark' ? 'dark' : 'light';
            const bg = mode === 'dark'
                ? `url('/static/img/bg-dark.jpg?v=${themeAssetVersion}')`
                : `url('/static/img/bg-light.jpg?v=${themeAssetVersion}')`;

            document.documentElement.setAttribute('data-bs-theme', mode);
            document.documentElement.style.setProperty('--app-background-image', bg);
        })();
    </script>
    <link rel="icon"
          type="image/svg+xml"
          href="/static/favicon.svg">
    <link rel="stylesheet"
          href="/static/ibm-plex-sans.css">
    <link rel="stylesheet"
          href="/static/bootstrap.css">
    <link rel="stylesheet"
          href="/static/ui-shell.css">
    <link rel="stylesheet"
          href="/static/theme.css?v={{theme_asset_version}}">
    <link rel="stylesheet"
          href="/static/bootstrap-overrides.css">
    <style>
        [x-cloak] {
            display: none !important;
        }

        #global-htmx-indicator {
            display: none;
        }

        body.htmx-request #global-htmx-indicator {
            display: block;
        }
    </style>
    <script src="/static/htmx.js"></script>
    <script src="/static/bootstrap.bundle.js"></script>
    <script src="/static/toast.js"></script>
    <script>
        function showNetworkErrorToast() {
            showToast('Der Server ist derzeit nicht erreichbar. Bitte lade die Seite neu.', 'danger');
        }

        document.addEventListener('htmx:responseError', function(evt) {
            const xhr = evt.detail.xhr;
            if (xhr.status >= 400) {
                showToast(xhr.responseText || 'Ein Fehler ist aufgetreten', 'danger');
            }
            // Endet das Examen, während das Formular noch offen ist, wird
            // der Upload mit 403 abgelehnt. Dann das Panel neu holen,
            // damit der geschlossene Hinweis das Formular ersetzt (#160).
            // Der Server bleibt die Wahrheit: läuft das Examen doch noch
            // (etwa nach „WLAN verlassen"), kommt dasselbe Formular leer
            // zurück.
            const elt = evt.detail.elt;
            if (xhr.status === 403 && elt && elt.closest && elt.closest('#abgabe-form')) {
                htmx.ajax('GET', '/abgabe-panel', { target: '#abgabe-panel', swap: 'innerHTML' });
            }
        });

        document.addEventListener('htmx:sendError', function() {
            showNetworkErrorToast();
        });

        document.addEventListener('htmx:timeout', function() {
            showNetworkErrorToast();
        });

        document.addEventListener('htmx:afterSwap', function(evt) {
            if (evt.detail.target && evt.detail.target.id === 'app-content') {
                // Das Dokument scrollt als Ganzes (#154): #app-main ist kein
                // eigener Scrollcontainer mehr. Ohne das landet man nach
                // einem Boost-Klick (z. B. auf den Hero) mitten auf der Seite.
                window.scrollTo({ top: 0, behavior: 'auto' });
                // Initialize Alpine.js on new content
                if (window.Alpine && evt.detail.target) {
                    Alpine.initTree(evt.detail.target);
                }
            }
            // Das Abgabe-Panel bringt ebenfalls x-data mit (Dateiname bei
            // Drag & Drop). Der Countdown läuft seit #161 in
            // `static/events.js`; ohne diese Initialisierung bliebe der
            // Dateiname nach einem Panel-Swap beim Platzhalter.
            if (evt.detail.target && evt.detail.target.id === 'abgabe-panel' && window.Alpine) {
                Alpine.initTree(evt.detail.target);
            }
            if (evt.detail.target && evt.detail.target.id === 'ip-detail-modal-content') {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('ip-detail-modal')).show();
            }
            if (evt.detail.target && evt.detail.target.id === 'exam-admin-panel') {
                syncExamFirewallModal();
            }
            if (evt.detail.target && evt.detail.target.id === 'abgabe-panel') {
                showAbgabeToast();
            }
        });

        // Erfolg einer Abgabe kommt als Toast; das Formular bleibt stehen
        // (#146). Die Meldung steht als Datenattribut im frisch getauschten
        // Panel, damit sie den Swap überlebt.
        function showAbgabeToast() {
            const toast = document.getElementById('abgabe-toast');
            if (!toast) {
                return;
            }
            showToast(toast.dataset.message || 'Abgabe hochgeladen.', toast.dataset.type || 'success');
            toast.remove();
        }

        // Das Firewall-Modal liegt außerhalb des austauschbaren Panels und
        // wird nicht wegklickbar gezeigt, solange die Sperre nicht bestätigt
        // ist (Status unbekannt oder API-Fehler). Der Trigger kommt aus dem
        // Panel selbst (data-show/data-message), damit ein Panel-Swap das
        // Modal nicht als verwaistes Backdrop zurücklässt.
        function syncExamFirewallModal() {
            const modalElement = document.getElementById('exam-firewall-modal');
            const data = document.getElementById('exam-firewall-modal-data');
            if (!modalElement || !data) {
                return;
            }

            const detail = document.getElementById('exam-firewall-modal-detail');
            if (detail) {
                detail.textContent = data.dataset.message || '';
            }

            const instance = bootstrap.Modal.getOrCreateInstance(modalElement);
            if (data.dataset.show === 'true') {
                instance.show();
            } else if (modalElement.classList.contains('show')) {
                instance.hide();
            }
        }

        document.addEventListener('DOMContentLoaded', syncExamFirewallModal);
    </script>
    <script src="/static/alpine.js"
            defer></script>
    <script src="/static/events.js"
            defer></script>
</head>

     <body{{#if remote_user}} data-exam-events{{/if}}>
    <header style="backdrop-filter: blur(var(--CTBS-GlassBlur)); -webkit-backdrop-filter: blur(var(--CTBS-GlassBlur));">
        <div class="container position-relative px-2 pt-2">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body py-2 px-3 d-flex flex-wrap flex-wrap-reverse align-items-center gap-2">
                <h1 class="mb-0 text-center text-body flex-grow-1 fs-2">
                    <a id="hero-link"
                       href="/"
                       hx-boost="true"
                       hx-target="#app-content"
                       class="text-reset text-decoration-none d-block"
                       aria-label="Zur Startseite — Angabe und Abgabe">{{hero_url}}</a>
                </h1>
                <button id="theme-toggle"
                        type="button"
                        aria-label="Hell-Dunkel-Modus wechseln"
                        class="btn btn-sm btn-outline-info rounded-3 px-3 ms-auto">Dunkel</button>
                </div>
            </div>
        </div>
    </header>
    <script>
        (function () {
            const storageKey = 'uploadthing-mode';
            const themeAssetVersion = '{{theme_asset_version}}';
            const backgrounds = {
                light: `url('/static/img/bg-light.jpg?v=${themeAssetVersion}')`,
                dark: `url('/static/img/bg-dark.jpg?v=${themeAssetVersion}')`,
            };

            function setMode(mode) {
                const nextMode = mode === 'dark' ? 'dark' : 'light';
                const toggleBtn = document.getElementById('theme-toggle');

                document.documentElement.setAttribute('data-bs-theme', nextMode);
                document.documentElement.style.setProperty('--app-background-image', backgrounds[nextMode]);

                if (toggleBtn) {
                    toggleBtn.textContent = nextMode === 'light' ? 'Dunkel' : 'Hell';
                }

                localStorage.setItem(storageKey, nextMode);
            }

            const savedMode = localStorage.getItem(storageKey);
            setMode(savedMode === 'dark' ? 'dark' : 'light');

            window.addEventListener('load', () => {
                const toggleBtn = document.getElementById('theme-toggle');
                toggleBtn.addEventListener('click', () => {
                    const currentMode = document.documentElement.getAttribute('data-bs-theme');
                    setMode(currentMode === 'dark' ? 'light' : 'dark');
                });
            });
        })();
    </script>
    <script>
        (function () {
            let activeHtmxRequests = 0;

            function trackHtmxRequest(event) {
                const requestConfig = event.detail?.requestConfig;
                if (!requestConfig) {
                    return;
                }
                requestConfig._globalSpinnerTracked = true;
            }

            function untrackHtmxRequest(event) {
                const requestConfig = event.detail?.requestConfig;
                if (!requestConfig?._globalSpinnerTracked) {
                    return false;
                }
                requestConfig._globalSpinnerTracked = false;
                return true;
            }

            function updateGlobalIndicator() {
                document.body.classList.toggle('htmx-request', activeHtmxRequests > 0);
            }

            document.body.addEventListener('htmx:beforeRequest', function (event) {
                trackHtmxRequest(event);
                activeHtmxRequests += 1;
                updateGlobalIndicator();
            });

            document.body.addEventListener('htmx:abort', function (event) {
                if (!untrackHtmxRequest(event)) {
                    return;
                }
                activeHtmxRequests = Math.max(0, activeHtmxRequests - 1);
                updateGlobalIndicator();
            });

            document.body.addEventListener('htmx:afterRequest', function (event) {
                if (!untrackHtmxRequest(event)) {
                    return;
                }
                activeHtmxRequests = Math.max(0, activeHtmxRequests - 1);
                updateGlobalIndicator();
            });

            document.body.addEventListener('htmx:sendError', function (event) {
                if (!untrackHtmxRequest(event)) {
                    return;
                }
                activeHtmxRequests = Math.max(0, activeHtmxRequests - 1);
                updateGlobalIndicator();
            });

            document.body.addEventListener('htmx:responseError', function (event) {
                if (!untrackHtmxRequest(event)) {
                    return;
                }
                activeHtmxRequests = Math.max(0, activeHtmxRequests - 1);
                updateGlobalIndicator();
            });

            document.body.addEventListener('htmx:beforeRequest', function (event) {
                const trigger = event.detail?.elt;
                if (!trigger || !trigger.closest('#admin-report-panel')) {
                    return;
                }

                const hasOpenDetails = Boolean(document.querySelector('#admin-report-panel details[open]'));
                const anomalyAccordionOpen = Boolean(document.querySelector('#admin-anomaly-collapse.show'));
                if (hasOpenDetails || anomalyAccordionOpen) {
                    if (untrackHtmxRequest(event)) {
                        activeHtmxRequests = Math.max(0, activeHtmxRequests - 1);
                        updateGlobalIndicator();
                    }
                    event.preventDefault();
                }
            });
        })();
    </script>
    {{> main}}

    <div class="modal fade"
         id="exam-firewall-modal"
         tabindex="-1"
         aria-labelledby="exam-firewall-modal-title"
         aria-hidden="true"
         data-bs-backdrop="static"
         data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger-subtle">
                    <h5 class="modal-title" id="exam-firewall-modal-title">Exam-Sperre nicht bestätigt</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Der Zustand der Firewall-Regel konnte nicht gelesen oder nicht geschaltet werden. Solange das nicht geklärt ist, ist der Internetzugang im Prüfungsnetz <strong>nicht</strong> verlässlich gesperrt.</p>
                    <p class="mb-0 small text-body-secondary" id="exam-firewall-modal-detail"></p>
                </div>
                <div class="modal-footer">
                    <form hx-post="/api/exammode"
                          hx-target="#exam-admin-panel"
                          hx-swap="outerHTML"
                          hx-disabled-elt="find button[type='submit']"
                          class="w-100">
                        <button type="submit"
                                class="btn btn-danger w-100">Erneut sperren</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
